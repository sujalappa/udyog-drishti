# Google Cloud project registered for Earth Engine (required).
# Authenticate once on the machine with:  earthengine authenticate
GEE_PROJECT=curious-subject-513110-r4

# Hosted copies: a service-account JSON key, passed as a secret instead of the machine login
# GEE_SERVICE_ACCOUNT_KEY=

# Where jobs are stored (default: ./data)
# UDYOGDRISHTI_DATA_DIR=./data

# Sign-in (optional). Off by default; set UDYOGDRISHTI_REQUIRE_LOGIN=true and an admin password to switch it on.
# UDYOGDRISHTI_REQUIRE_LOGIN=true
# UDYOGDRISHTI_ADMIN_USER=admin
# UDYOGDRISHTI_ADMIN_PASSWORD=
# UDYOGDRISHTI_SECRET_KEY=
# UDYOGDRISHTI_USERS_REPO=
# UDYOGDRISHTI_USERS_TOKEN=
